<Window x:Class="CardArchive.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="فهرس البطاقات الوطنية" Icon="Assets/CardArchive.ico" Width="1280" Height="820" MinWidth="1050" MinHeight="700"
 WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
 Background="{DynamicResource PageBg}" FontFamily="Segoe UI" Foreground="{DynamicResource TextMain}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="238"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Margin="34,28,30,26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
     <TextBlock Text="إدارة السجلات" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
     <TextBlock Text="فهرس البطاقات الوطنية" FontSize="28" FontWeight="Bold"/>
     <TextBlock Text="إدارة بيانات أصحاب البطاقات والبحث عنها بسهولة" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
     <Button Content="Aa  تنسيق الخط" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="FontSettingsButton_Click"/>
     <Button x:Name="ThemeButton" Content="☾  الوضع الليلي" Style="{StaticResource SecondaryButton}" Click="ThemeButton_Click"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
    <Border Grid.Column="1" Background="#E9F1FF" CornerRadius="15" Padding="18" Margin="12,0,0,0">
     <StackPanel>
      <TextBlock Text="إجمالي السجلات" Foreground="#55729B" FontSize="13"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
       <TextBlock x:Name="CountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="#1D4ED8"/>
       <TextBlock Text="  بطاقة مسجلة" VerticalAlignment="Bottom" Margin="5,0,0,5" Foreground="#55729B"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="15" Padding="18" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1">
     <StackPanel>
      <TextBlock Text="معلومة" FontWeight="SemiBold" FontSize="13"/>
      <TextBlock Text="تُحفظ البيانات تلقائياً في جهازك، ولا تحتاج إلى اتصال بالإنترنت." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1.5" CornerRadius="17" Padding="22" Margin="0,0,0,18">
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.07" Color="#42618C"/></Border.Effect>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock x:Name="FormTitle" Text="إضافة بطاقة جديدة" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
      <TextBlock Text="أدخل اسم صاحب البطاقة ورقمها الوطنية، أو فعّل الترقيم التلقائي" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
     </StackPanel>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
       <TextBlock Text="اسم صاحب البطاقة" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <TextBox x:Name="NameBox" Height="44" FlowDirection="RightToLeft" KeyDown="Input_KeyDown"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
       <Grid Margin="0,0,0,7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="رقم البطاقة الوطنية" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <CheckBox Grid.Column="1" x:Name="AutoNumberCheck" Content="ترقيم تلقائي" IsChecked="False" VerticalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold" Checked="AutoNumberCheck_Changed" Unchecked="AutoNumberCheck_Changed"/>
       </Grid>
       <TextBox x:Name="NumberBox" Height="44" FlowDirection="RightToLeft" KeyDown="Input_KeyDown"/>
      </StackPanel>
      <Button x:Name="SaveButton" Grid.Column="2" Content="حفظ البيانات" Height="44" MinWidth="120" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="SaveButton_Click"/>
      <Button Grid.Column="3" Content="تفريغ" Height="44" MinWidth="85" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}" Click="ClearButton_Click"/>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="15" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,15">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
       <TextBlock Text="قائمة البطاقات" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
       <TextBlock Text="ابحث عن صاحب البطاقة بالاسم أو الرقم الوطني" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Row="1" Width="560" MaxWidth="560" HorizontalAlignment="Center" Background="#F3F7FF" BorderBrush="#C9D9F5" BorderThickness="1" CornerRadius="12" Padding="4">
       <DockPanel>
        <TextBlock Text="⌕" FontSize="25" Foreground="#3972C8" VerticalAlignment="Center" Margin="10,0,7,0"/>
        <TextBox x:Name="SearchBox" Height="44" BorderThickness="0" Background="Transparent" FontSize="15" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="ابحث بالاسم أو رقم البطاقة" TextChanged="SearchBox_TextChanged"/>
       </DockPanel>
      </Border>
     </Grid>
     <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="استيراد CSV" Style="{StaticResource SecondaryButton}" Margin="0,0,0,0" Click="ImportButton_Click"/>
       <Button Content="تصدير CSV" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ExportButton_Click"/>
       <Button Content="نسخة احتياطية" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BackupButton_Click"/>
       <Button Content="طباعة القائمة" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PrintButton_Click"/>
      </StackPanel>
      <TextBlock x:Name="ResultsText" Text="0 نتيجة" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
     </DockPanel>
     <DataGrid x:Name="PeopleGrid" Grid.Row="2" ItemsSource="{Binding People}" AlternationCount="2">
      <DataGrid.Columns>
       <DataGridTextColumn Header="اسم صاحب البطاقة" Binding="{Binding FullName}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="FlowDirection" Value="RightToLeft"/><Setter Property="Padding" Value="0,4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="رقم البطاقة الوطنية" Binding="{Binding CardNumber}" Width="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Padding" Value="0,4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTemplateColumn Header="الإجراءات" Width="190">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="تعديل" Padding="12,7" Margin="0,0,7,0" Click="EditRow_Click"/>
          <Button Content="حذف" Style="{StaticResource DangerButton}" Click="DeleteRow_Click"/>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <TextBlock Grid.Row="4" Text="CardArchive  •  يعمل محلياً ويحافظ على خصوصية بياناتك" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="4,13,4,0"/>
  </Grid>
  <Border Grid.Column="1" Background="#172B49">
   <Grid Margin="22,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,38">
     <Border Width="48" Height="48" CornerRadius="14" Background="#2C5DA8" HorizontalAlignment="Right">
      <TextBlock Text="▤" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="CardArchive" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,14,0,3"/>
     <TextBlock Text="فهرس البطاقات الوطنية" FontSize="11" Foreground="#A9B9D1"/>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="القائمة الرئيسية" FontSize="11" Foreground="#8499B8" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="2">
     <Border Background="#294A78" CornerRadius="9" Padding="13,12" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="White" FontSize="17" Margin="0,0,10,0"/><TextBlock Text="السجلات والبطاقات" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </Border>
     <TextBlock Text="جميع البيانات محفوظة على هذا الجهاز" TextWrapping="Wrap" Foreground="#8499B8" FontSize="11" Margin="4,16,4,0"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <Border Height="1" Background="#314563" Margin="0,0,0,15"/>
     <TextBlock Text="الإصدار 2.0" Foreground="#8499B8" FontSize="11"/>
     <TextBlock Text="واجهة WPF الحديثة" Foreground="#8499B8" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>