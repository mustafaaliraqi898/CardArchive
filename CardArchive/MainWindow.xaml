<Window x:Class="CardArchive.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="فهرس البطاقات الوطنية" Width="1280" Height="820" MinWidth="1050" MinHeight="700"
 WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
 Background="{StaticResource PageBg}" FontFamily="Segoe UI" Foreground="{StaticResource TextMain}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="238"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Margin="34,28,30,26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,25">
    <StackPanel>
     <TextBlock Text="إدارة السجلات" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
     <TextBlock Text="فهرس البطاقات الوطنية" FontSize="28" FontWeight="Bold"/>
     <TextBlock Text="إدارة بيانات أصحاب البطاقات والبحث عنها بسهولة" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,7,0,0"/>
    </StackPanel>
    <Button x:Name="ThemeButton" Content="☾  الوضع الليلي" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ThemeButton_Click"/>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
    <Border Grid.Column="1" Background="#E9F1FF" CornerRadius="15" Padding="18" Margin="12,0,0,0">
     <StackPanel>
      <TextBlock Text="إجمالي السجلات" Foreground="#55729B" FontSize="13"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
       <TextBlock x:Name="CountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="#1D4ED8"/>
       <TextBlock Text="  بطاقة مسجلة" VerticalAlignment="Bottom" Margin="5,0,0,5" Foreground="#55729B"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="15" Padding="18" BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
     <StackPanel>
      <TextBlock Text="معلومة" FontWeight="SemiBold" FontSize="13"/>
      <TextBlock Text="تُحفظ البيانات تلقائياً في جهازك، ولا تحتاج إلى اتصال بالإنترنت." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" CornerRadius="15" Padding="20" Margin="0,0,0,18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock x:Name="FormTitle" Text="إضافة بطاقة جديدة" FontSize="17" FontWeight="Bold"/>
      <TextBlock Text="أدخل اسم صاحب البطاقة ورقمها الوطنية" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
     </StackPanel>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,12,0">
       <TextBlock Text="اسم صاحب البطاقة" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <TextBox x:Name="NameBox" Height="44" FlowDirection="RightToLeft" KeyDown="Input_KeyDown"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
       <TextBlock Text="رقم البطاقة الوطنية" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <TextBox x:Name="NumberBox" Height="44" FlowDirection="RightToLeft" KeyDown="Input_KeyDown"/>
      </StackPanel>
      <Button x:Name="SaveButton" Grid.Column="2" Content="حفظ البيانات" Height="44" MinWidth="120" VerticalAlignment="Bottom" Margin="0,0,8,0" Click="SaveButton_Click"/>
      <Button Grid.Column="3" Content="تفريغ" Height="44" MinWidth="85" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}" Click="ClearButton_Click"/>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderLine}" BorderThickness="1" CornerRadius="15" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,15">
      <StackPanel>
       <TextBlock Text="قائمة البطاقات" FontSize="18" FontWeight="Bold"/>
       <TextBlock Text="يمكنك البحث بالاسم أو رقم البطاقة" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBox x:Name="SearchBox" Width="310" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="ابحث بالاسم أو رقم البطاقة" TextChanged="SearchBox_TextChanged"/>
     </Grid>
     <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="استيراد CSV" Style="{StaticResource SecondaryButton}" Margin="0,0,0,0" Click="ImportButton_Click"/>
       <Button Content="تصدير CSV" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ExportButton_Click"/>
       <Button Content="نسخة احتياطية" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BackupButton_Click"/>
       <Button Content="طباعة القائمة" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PrintButton_Click"/>
      </StackPanel>
      <TextBlock x:Name="ResultsText" Text="0 نتيجة" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12"/>
     </DockPanel>
     <DataGrid x:Name="PeopleGrid" Grid.Row="2" ItemsSource="{Binding People}" AlternationCount="2">
      <DataGrid.Columns>
       <DataGridTextColumn Header="اسم صاحب البطاقة" Binding="{Binding FullName}" Width="*"/>
       <DataGridTextColumn Header="رقم البطاقة الوطنية" Binding="{Binding CardNumber}" Width="220"/>
       <DataGridTemplateColumn Header="الإجراءات" Width="190">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="تعديل" Padding="12,7" Margin="0,0,7,0" Click="EditRow_Click"/>
          <Button Content="حذف" Style="{StaticResource DangerButton}" Click="DeleteRow_Click"/>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <TextBlock Grid.Row="4" Text="CardArchive  •  يعمل محلياً ويحافظ على خصوصية بياناتك" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="4,13,4,0"/>
  </Grid>
  <Border Grid.Column="1" Background="#172B49">
   <Grid Margin="22,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,38">
     <Border Width="48" Height="48" CornerRadius="14" Background="#2C5DA8" HorizontalAlignment="Right">
      <TextBlock Text="▤" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="CardArchive" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,14,0,3"/>
     <TextBlock Text="فهرس البطاقات الوطنية" FontSize="11" Foreground="#A9B9D1"/>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="القائمة الرئيسية" FontSize="11" Foreground="#8499B8" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="2">
     <Border Background="#294A78" CornerRadius="9" Padding="13,12" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="White" FontSize="17" Margin="0,0,10,0"/><TextBlock Text="السجلات والبطاقات" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     </Border>
     <TextBlock Text="جميع البيانات محفوظة على هذا الجهاز" TextWrapping="Wrap" Foreground="#8499B8" FontSize="11" Margin="4,16,4,0"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <Border Height="1" Background="#314563" Margin="0,0,0,15"/>
     <TextBlock Text="الإصدار 2.0" Foreground="#8499B8" FontSize="11"/>
     <TextBlock Text="واجهة WPF الحديثة" Foreground="#8499B8" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>